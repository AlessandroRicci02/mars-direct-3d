{
  "name": "mars-direct",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "format": "prettier --write src tests *.json *.ts *.md index.html",
    "format:check": "prettier --check src tests *.json *.ts *.md index.html"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.3.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
